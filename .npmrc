# @typechain/hardhat@9.1.0 declares a peer dependency on hardhat@^2.9.9, but this project
# uses hardhat@3.x. Without this, `npm ci` / `npm install` fail with ERESOLVE on a clean
# machine (CI, the Linux gate-runner box, fresh clones). Keep until @typechain/hardhat ships
# a hardhat-3-compatible peer range.
legacy-peer-deps=true
