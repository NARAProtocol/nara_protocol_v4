{
  "name": "nara-landing",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "deploy:cf": "npm run build && npx wrangler@latest pages deploy dist --project-name nara-landing",
    "deploy:cf:prod": "npm run build && npx wrangler@latest pages deploy dist --project-name nara-landing --branch main"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.7",
    "framer-motion": "^11.3.19",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.4.19",
    "playwright": "^1.60.0",
    "postcss": "^8.4.40",
    "tailwindcss": "^3.4.7",
    "typescript": "^5.5.4",
    "vite": "^8.2.2"
  }
}
