{
  "name": "nara-landing",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check:denylist": "node scripts/check-denylist.cjs",
    "test:api": "node --test tests/leaderboard.test.mjs tests/supply.test.mjs tests/quote.test.mjs",
    "test:smoke": "node tests/smoke.mjs",
    "check": "npm run check:denylist && npm run test:api && npm run build",
    "pages:dev": "wrangler pages dev dist --port 8788 --kv NARA_LEADERBOARD_KV",
    "deploy:cf:preview": "node scripts/deploy-pages.mjs preview",
    "deploy:cf:prod": "node scripts/deploy-pages.mjs main"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.19",
    "playwright": "^1.60.0",
    "postcss": "^8.4.40",
    "tailwindcss": "^3.4.7",
    "vite": "^5.3.5",
    "wrangler": "^4.0.0"
  }
}
