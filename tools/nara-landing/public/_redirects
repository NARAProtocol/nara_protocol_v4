# so nothing on this domain sends a visitor to a swap while trading is paused. At launch,
# change the four /swap targets to https://cryptoslip.eth.limo/ in the same commit that flips
# SWAP_PUBLIC_LAUNCHED in src/meme/config.js.
/swap        /  302
/swap.html   /  302
/app         /  301
/app.html    /  301
/meme        /  301
/meme.html   /  301
/swap/*      /  302
/app/*       /  301
