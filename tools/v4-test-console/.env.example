# Public Reown project ID used by WalletConnect-based mobile wallets.
# The older VITE_WALLETCONNECT_PROJECT_ID and VITE_RAINBOW_PROJECT_ID names
# remain accepted during migration, but new deployments should use this name.
VITE_REOWN_PROJECT_ID=

# Optional public Base RPC URL. Any value here is shipped to the browser.
VITE_BASE_RPC_URL=

# Optional public error-reporting configuration. When VITE_SENTRY_DSN is
# empty, the Sentry SDK is not loaded and no telemetry is sent. Never put a
# Sentry auth token or another secret in a VITE_ variable.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=preview
VITE_SENTRY_RELEASE=

# Server-only Coinbase Onramp credentials. Never add a VITE_ prefix.
# Create an ECDSA (ES256) Secret API Key in CDP and configure these as
# encrypted Cloudflare Pages secrets. ONRAMP_STATE is a KV namespace binding,
# not a string environment variable.
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=

# Optional server-only CDP Paymaster endpoint. Never add a VITE_ prefix.
# PAYMASTER_STATE is a separate KV namespace binding. Configure an Engine,
# NARA, USDC, Permit2, and Universal Router contract allowlist plus strict
# per-operation, per-address, and global spend limits in the CDP Portal.
CDP_PAYMASTER_URL=
CDP_PAYMASTER_POLICY_ID=
