# Local development does not require any value in this file.
# Copy to .env only when running an explicitly selected fork or read-only
# verification task. Never commit .env or use a production signing key.

# Optional read-only Base RPC used by fork and onchain verification tasks.
BASE_RPC_URL=

# Optional explorer API key used only for source verification.
BASESCAN_API_KEY=

# Current non-secret v4 addresses are generated from
# deployments/v4-production-activation-2026-08-09.json. Review the output
# before explicitly copying its keys into a local .env:
#   npm run v4:env:sync
#   npm run v4:env:sync:write
# The generated config must contain Compounder
# 0xfeFcc45C0454D022586eaA8a5c51BD25DCe713DF and LP NFT 2898124. Never copy
# retired July addresses or a pre-activation LP token ID of zero.

# Signing variables intentionally remain absent. Deployment and production-write
# procedures require separate human authorization and an isolated environment.
